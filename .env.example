# === Mia Assistant — пример конфигурации ===
# Скопируйте этот файл в .env и заполните значения.
# cp .env.example .env   (Windows:  copy .env.example .env)

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=
# Username бота (с @), нужен для реакции на упоминания в группах
BOT_USERNAME=@mia_assistant_wd_bot

# --- Ollama (локальная LLM) ---
# Базовый адрес Ollama. По умолчанию Ollama слушает 11434.
OLLAMA_BASE_URL=http://localhost:11434
# Рабочая модель (текст, русский). Днём — лёгкая/средняя.
# Примеры: qwen2.5:14b-instruct, qwen2.5:7b-instruct, gemma2:9b
LLM_MODEL=qwen2.5:14b-instruct
# Модель эмбеддингов для памяти (RAG). Мультиязычная, сильна в русском.
EMBED_MODEL=bge-m3

# Параметры генерации
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1200
# Таймаут запроса к модели (сек) — локальные модели бывают медленными
LLM_TIMEOUT=300

# Vision-модель для распознавания сканов (OCR). Скачать: ollama pull qwen2.5vl:7b
VISION_MODEL=qwen2.5vl:7b
# Максимум страниц скана для OCR и DPI рендера
OCR_MAX_PAGES=15
OCR_DPI=180

# --- Данные ---
# Папка для базы данных, векторов, документов и логов.
# Windows-пример:  C:\Mia\data
DATA_DIR=data

# --- Время ---
# Часовой пояс для понимания времени и напоминаний.
TIMEZONE=Europe/Moscow

# --- AnythingLLM (RAG для свободных вопросов по документам) ---
# Адрес AnythingLLM, API-ключ (Settings -> Developer API) и имя workspace.
# Если пусто — бот работает без RAG, на своей памяти.
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=mia

# --- Конфигуратор: автообновление и логи ---
# Репозиторий (owner/repo).
GITHUB_REPO=Shadowsector/Mia
# Ветка, с которой конфигуратор тянет обновления. Пусто = текущая ветка.
UPDATE_BRANCH=
# Токен GitHub (Personal Access Token, scope: repo). Нужен ТОЛЬКО чтобы
# отправлять логи на GitHub и для приватного репозитория. Можно оставить пустым.
GITHUB_TOKEN=
# Автопроверка обновлений каждые N минут (0 — только вручную по кнопке).
AUTO_UPDATE_INTERVAL_MIN=0

# --- llama.cpp (???????? LLM ??? Mia PM OS) ---
# llama-server ??????????? start_llama_server.bat ??? GUI (?? ????????? ???? 8080).
LLAMA_BASE_URL=http://localhost:8080
# ??? ?????? ??? OpenAI-???????????? API (llama-server ????????? ????? ???;
# ???????? ?????? ? ??????????? .gguf).
LLAMA_MODEL=qwen2.5:14b-instruct
# ?????? ??????????? (????? llama-server ? ?????? --embeddings). ????? ? ???????? ??????.
LLAMA_EMBED_MODEL=

# --- ??????????? ?????? PM OS ---
ALERTS_ENABLED=true
# Telegram chat_id ?????????? ??????? (????????????). ????? ? ?????? ?????? ? ???.
ALERTS_CHAT_ID=
